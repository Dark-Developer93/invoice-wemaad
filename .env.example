# ─────────────────────────────────────────────
# App
# ─────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here"

# Public URL — used in magic-link emails and invoice share links
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─────────────────────────────────────────────
# Admin account (auto-seeded on startup)
# ─────────────────────────────────────────────
# The admin account is created automatically when docker compose starts.
# Sign in with this email — the magic link will arrive in Mailhog (http://localhost:8025).
ADMIN_EMAIL=admin@localhost.dev
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User

# ─────────────────────────────────────────────
# Email / SMTP
# ─────────────────────────────────────────────
# Default: local Mailhog container (no credentials needed).
# Emails arrive at http://localhost:8025 — no external account required.
# For production: replace with your real SMTP provider credentials.
EMAIL_SERVER_HOST=mailhog
EMAIL_SERVER_PORT=1025
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=noreply@localhost.dev

# Mailtrap API token (optional — only needed if using the Mailtrap SDK directly)
MAILTRAP_TOKEN=

# ─────────────────────────────────────────────
# Cron jobs
# ─────────────────────────────────────────────
# Generate with: openssl rand -base64 32
CRON_SECRET=your-cron-secret-here

# ─────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────
# When using Docker Compose, DATABASE_URL is assembled automatically from
# POSTGRES_* vars below — you do not need to set it manually.
# For local dev (without Docker), set this directly:
# DATABASE_URL="postgresql://invoice:invoice_pass@localhost:5432/invoice_db"
POSTGRES_USER=invoice
POSTGRES_PASSWORD=invoice_pass
POSTGRES_DB=invoice_db
