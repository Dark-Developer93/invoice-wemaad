# AuthJS — generate with: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here"

# App URL (used for invoice share links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# PostgreSQL connection string
# When using Docker Compose, this is auto-assembled from POSTGRES_* vars below
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Email Server (SMTP)
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=your-smtp-user
EMAIL_SERVER_PASSWORD="your-smtp-password"
EMAIL_FROM=hello@yourdomain.com

# Mailtrap (optional — for email testing)
MAILTRAP_TOKEN=

# Cron Jobs — generate with: openssl rand -base64 32
CRON_SECRET=your-cron-secret-here

# Docker Compose only — PostgreSQL container credentials
# DATABASE_URL is assembled from these automatically; no need to set it manually
POSTGRES_USER=invoice
POSTGRES_PASSWORD=invoice_pass
POSTGRES_DB=invoice_db
